# ============================================================
# CloudCart Backend — .dockerignore
#
# Works exactly like .gitignore but for Docker.
# Files listed here are EXCLUDED from the Docker build context.
# This means Docker will NOT copy them into the image.
#
# Why this matters:
#   - Smaller image size
#   - Faster builds (less data sent to Docker daemon)
#   - Security (no secrets inside the image)
# ============================================================

# node_modules — MOST IMPORTANT exclusion.
# We never copy node_modules from the host machine into the image.
# Reason: packages are compiled for the host OS (e.g. macOS/Windows).
# The container runs Alpine Linux — it needs its own compiled binaries.
# The RUN npm ci command inside the Dockerfile installs the correct ones.
node_modules/

# .env files — CRITICAL for security.
# Real secrets (MONGO_URI, JWT_SECRET) must NEVER be baked into an image.
# They will be passed at runtime via docker run -e or docker-compose.yml.
.env
.env.*
!.env.example

# Development-only files — not needed in production container
*.log
npm-debug.log*

# Git files — not needed inside the container
.git/
.gitignore

# The Dockerfile itself — no need to include it in the image
Dockerfile
.dockerignore

# Test and coverage files — not needed in production
coverage/
__tests__/
*.test.js
*.spec.js

# Editor/IDE files
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# PM2 config — used on EC2, not needed in Docker
ecosystem.config.js
.pm2/

tests/
