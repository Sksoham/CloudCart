# ============================================================
# CloudCart Frontend — .dockerignore
#
# Keeps the Docker build context small and secure.
# ============================================================

# node_modules — never copy from host.
# Stage 1 of the Dockerfile runs npm ci to install fresh ones.
node_modules/

# Build output — Stage 1 creates a fresh build inside the container.
build/

# Environment files — API URL is passed as a build ARG, not copied.
.env
.env.*
.env.local
.env.development
.env.production
!.env.example

# Git files
.git/
.gitignore

# Docker files themselves
Dockerfile
.dockerignore

# Editor/OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*

# Test files — not needed for production build
src/**/*.test.js
src/**/*.spec.js
coverage/
